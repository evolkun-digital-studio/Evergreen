{
  "name": "evergreen",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "node scripts/validate-production-env.mjs && next build && node scripts/prepare-production-build.mjs",
    "verify:production": "node scripts/verify-production-build.mjs",
    "start": "next start",
    "check": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:indexes": "tsx --conditions=react-server scripts/sync-indexes.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:rescore": "tsx --conditions=react-server scripts/rescore.ts",
    "email:test": "tsx --conditions=react-server scripts/email-test.ts",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "epr:data": "tsx scripts/build-epr-data.ts",
    "copy:check": "tsx scripts/check-duplicate-copy.ts",
    "fonts:check": "tsx scripts/check-franie-glyphs.ts",
    "links:check": "tsx scripts/check-links.ts",
    "responsive:check": "tsx scripts/check-responsive.ts",
    "seo:check": "tsx scripts/check-seo.ts",
    "lint": "eslint .",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.22",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.453.0",
    "mongoose": "^9.11.4",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.3",
    "ffmpeg-static": "^5.3.0",
    "mongodb-memory-server": "^11.3.0",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=24.3.0 <25"
