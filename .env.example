# ---------------------------------------------------------------------------
# Evergreen website + CMS — environment variables
# Copy to .env (never commit .env) and fill in the values. Labels indicate scope.
# ---------------------------------------------------------------------------

# --- Required in production --------------------------------------------------
# [RUNTIME] Controls robots.txt. Use production only on the public deployment.
SITE_ENV=production
# [PUBLIC, BUILD-TIME] Canonical origin, no trailing slash. Rebuild if it changes.
NEXT_PUBLIC_SITE_URL=https://evergreenrecycler.in
# [RUNTIME] Auth.js origin. Must exactly match NEXT_PUBLIC_SITE_URL in production.
AUTH_URL=https://evergreenrecycler.in

# --- Database (MongoDB Atlas recommended) -------------------------------------
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local: run `npm run db:dev`, then use mongodb://127.0.0.1:27017/?replicaSet=rs0
# A replica set is required (Atlas always is) because slug changes and tag merges use transactions.
# Use a dedicated Atlas database user for Evergreen. Never point this at the IndiaWMS database.
MONGODB_URI=
MONGODB_DB=evergreen
# Optional fallback when the local DNS resolver refuses Atlas SRV lookups.
MONGODB_DNS_SERVERS=

# --- Auth (Auth.js v5) --------------------------------------------------------
# Generate with: openssl rand -base64 33   (or: npx auth secret)
AUTH_SECRET=
# [OPTIONAL, BUILD-TIME] Required when multiple app instances serve the same build.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# [BUILD/SEED ONLY] First admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME= 
# [OPTIONAL, RUNTIME] Transactional email through your own SMTP server. Set SMTP_HOST and
# ENQUIRY_EMAIL_FROM together. SMTP_USER / SMTP_PASS are needed only if the server asks for a login.
# Port 587 uses STARTTLS, 465 uses implicit TLS (override with SMTP_SECURE=true|false).
# ENQUIRY_EMAIL_TO is the fallback for new-request and enquiry alerts (comma-separated). Once alert
# emails are saved in admin Settings > Notifications, those are used instead.
# In development, reset/invite/access links are written to the server console when email is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
ENQUIRY_EMAIL_FROM=
ENQUIRY_EMAIL_TO=

# --- Media storage ------------------------------------------------------------
# local       -> files in /public/uploads (development only; not persistent on serverless hosts)
# s3          -> any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2…)
# imagekit    -> ImageKit media library
STORAGE_DRIVER=
# [OPTIONAL, RUNTIME] Defaults to STORAGE_DRIVER; accepts local or s3.
DOCUMENTS_STORAGE_DRIVER=
# [OPTIONAL, RUNTIME] Private bucket; falls back to S3_BUCKET.
DOCUMENTS_S3_BUCKET=

# S3 / Cloudflare R2 (STORAGE_DRIVER=s3)
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com, region: auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket (R2 custom domain or r2.dev URL), no trailing slash.
S3_PUBLIC_URL=

# ImageKit (STORAGE_DRIVER=imagekit)
IMAGEKIT_PRIVATE_KEY=
# e.g. https://ik.imagekit.io/rxoyjxx4c
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER= 

# Max upload size in megabytes.
MEDIA_MAX_UPLOAD_MB=10

# --- Indexing -----------------------------------------------------------------
# IndexNow key: 8–128 chars of [a-zA-Z0-9-]. Served automatically at /<key>.txt.
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=

# Optional: Google Indexing API service-account JSON (single line). Off by default in Settings;
# Google only supports it for JobPosting / BroadcastEvent pages.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Jobs ---------------------------------------------------------------------
# Shared secret for /api/cron/* (sent as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Signs draft-preview links (falls back to AUTH_SECRET when empty).
PREVIEW_SECRET=

# Optional fixed copyright year for reproducible builds.
NEXT_PUBLIC_BUILD_YEAR=

# [OPTIONAL, BUILD-TIME] Rolling-deployment identifier used by Next.js when configured.
DEPLOYMENT_VERSION=

# [RUNTIME] Standalone server bind settings. Usually supplied by systemd/container config.
PORT=3000
HOSTNAME=127.0.0.1

# [DEVELOPMENT/TEST ONLY]
DEV_DB_PORT=27017
INDIAWMS_SRC=
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=
